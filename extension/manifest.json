{
  "manifest_version": 3,
  "name": "ChatGPT Conversation Navigator",
  "version": "1.0.1",
  "description": "在 ChatGPT 长对话中搜索用户提问、平滑跳转。索引仅在当前页面内存中维护。",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["src/dom.js", "src/index.js", "src/navigation.js", "src/panel.js", "src/content.js"],
    "run_at": "document_idle",
    "all_frames": false,
    "world": "ISOLATED"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
